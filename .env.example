# Local development uses Vite's same-origin proxy by default.
# VITE_API_BASE_URL=/api
# VITE_WS_URL=/ws
# Vercel production example:
# VITE_API_BASE_URL=https://your-backend.example.com/api
# VITE_WS_URL=https://your-backend.example.com/ws
# Backend variables must be exported in the backend terminal (not VITE_ variables):
# JWT_SECRET=at_least_32_random_characters
# PORT=8081
# SEED_DEMO=false
